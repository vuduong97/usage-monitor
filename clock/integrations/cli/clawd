#!/usr/bin/env python3
"""clawd — poke the desk clock's Clawd through the clawd-home daemon.

  clawd wave [TEXT]                 Clawd celebrates (default "Hi!")
  clawd say TEXT [--anim A] [--secs N]
  clawd play ANIM [--text T] [--secs N]
  clawd focus MINUTES | clawd focus stop
  clawd clear                       drop the current poke
  clawd status                      what the clock shows + live agent sessions
  clawd anims                       animation names in desk.pak

Talks only to the daemon on 127.0.0.1 (CLAWD_EVENT_PORT, default 47913), so
agents can call it too. Exit code 1 when the daemon is not running.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

ANIMS = ["thinking", "typing", "building", "headphones", "juggling", "error", "happy",
         "notification", "sweeping", "carrying", "idle", "reading", "yawn", "doze",
         "sleeping", "wake", "low battery", "double jump", "heart eyes"]


def port() -> int:
    try:
        return int(os.environ.get("CLAWD_EVENT_PORT") or 47913)
    except ValueError:
        return 47913


def call(method: str, path: str, body: dict | None = None) -> tuple[int, dict]:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f"http://127.0.0.1:{port()}{path}", data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=3) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}


def build(argv: list[str]) -> tuple[str, str, dict | None]:
    ap = argparse.ArgumentParser(prog="clawd", description="Poke the desk clock's Clawd.")
    sub = ap.add_subparsers(dest="op", required=True)
    w = sub.add_parser("wave"); w.add_argument("text", nargs="*")
    s = sub.add_parser("say"); s.add_argument("text", nargs="+")
    s.add_argument("--anim"); s.add_argument("--secs", type=float)
    p = sub.add_parser("play"); p.add_argument("anim", nargs="+")
    p.add_argument("--text"); p.add_argument("--secs", type=float)
    f = sub.add_parser("focus"); f.add_argument("minutes")
    sub.add_parser("clear"); sub.add_parser("status"); sub.add_parser("anims")
    a = ap.parse_args(argv)
    if a.op == "status":
        return "GET", "/state", None
    if a.op == "anims":
        return "", "", None
    body: dict = {"cmd": a.op}
    if a.op == "wave" and a.text:
        body["text"] = " ".join(a.text)
    elif a.op == "say":
        body["text"] = " ".join(a.text)
        if a.anim: body["anim"] = a.anim
        if a.secs: body["secs"] = a.secs
    elif a.op == "play":
        body["anim"] = " ".join(a.anim)
        if a.text: body["text"] = a.text
        if a.secs: body["secs"] = a.secs
    elif a.op == "focus":
        body["mins"] = a.minutes
    return "POST", "/poke", body


def main(argv: list[str] | None = None) -> int:
    method, path, body = build(sys.argv[1:] if argv is None else argv)
    if not method:
        print("\n".join(ANIMS))
        return 0
    try:
        status, res = call(method, path, body)
    except (urllib.error.URLError, OSError):
        print("clawd: daemon not running on 127.0.0.1:%d" % port(), file=sys.stderr)
        return 1
    if path == "/state":
        d = res.get("desired", {})
        print(f"clock: {d.get('a') or '(usage screen)'}" + (f" - {d['txt']}" if d.get("txt") else ""))
        if res.get("focus_left"):
            m, s = divmod(res["focus_left"], 60)
            print(f"focus: {m:02d}:{s:02d} left")
        print(f"turns today: {res.get('turns', 0)}   away: {res.get('away')}")
        for s in res.get("sessions", []):
            print(f"  {s['sid'][:40]:40} {s['state']:10} {s.get('tool') or '':12} subs={s['subs']} {s['age']}s ago")
        return 0
    if status != 200 or not res.get("ok"):
        print(f"clawd: {res.get('error') or f'HTTP {status}'}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
