# Release secrets for rust-release.yml. NAMES ONLY: this template has no values.
#
#   1. Copy this file to `.env` in the repo root (`.env` is git-ignored: never commit it).
#   2. Fill in the values below (no quotes, one line each; the minisign key is a file: see below).
#   3. Run:  powershell -File packaging\set-release-secrets.ps1        (dry run, prints what it would set)
#            powershell -File packaging\set-release-secrets.ps1 -Apply   (sets them in GitHub)
#   4. Delete `.env` afterwards.
#
# Already stored as REPOSITORY secrets (created 2026-10-14 for the Python release), nothing to do:
#   APPLE_ID, APPLE_TEAM_ID, APPLE_APP_PASSWORD, MACOS_CERT_P12, MACOS_CERT_PASSWORD,
#   MACOS_SIGN_IDENTITY, CLAWD_FEED_URL, CLAWD_FEED_TOKEN
# A job bound to environment `release` can read repository secrets too.

# ---- secrets (environment `release`) -------------------------------------------------------
# Password you chose when running `minisign -G` (see packaging/README.md, "minisign key").
MINISIGN_PASSWORD=
# Path to the minisign SECRET key file (clawd-minisign.key). Its CONTENT becomes secret MINISIGN_KEY.
MINISIGN_KEY_FILE=

# ---- variables (public values, repository variables) ---------------------------------------
# Second line of clawd-minisign.pub (base64, starts with RW, 56 characters).
MINISIGN_PUBKEY=
# Apple Team ID of the Developer ID certificate that signed 0.1.4 (10 characters). It must be the
# same value as the existing secret APPLE_TEAM_ID, so existing installs accept the update.
EXPECTED_TEAM_ID=
