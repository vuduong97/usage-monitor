{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawd",
  "mainBinaryName": "Clawd",
  "version": "0.2.2",
  "identifier": "vn.clawd.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
